# ==============================================================================
# Harsh Bhongade Portfolio - Environment Variables Template
# Copy this file to .env.local (or configure in Vercel Project Settings)
# NEVER commit your real secrets or .env.local to GitHub!
# ==============================================================================

# Vite local dev server port
VITE_PORT=3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------

# Public Supabase URL (Used by client and server)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key (Safe for browser client)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ------------------------------------------------------------------------------
# Server-Side Secrets (CRITICAL: NEVER expose these to frontend / client-side)
# ------------------------------------------------------------------------------

# Supabase Service Role Secret Key (Server-only for admin operations & RLS bypass)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Designated Administrator Account Email (Used for server-side authorization check)
ADMIN_EMAIL=your_email@domain.com

# Cryptographic salt for privacy-preserving HMAC-SHA256 IP hashing
IP_SALT=create_a_random_32_character_secret_salt_here

# ------------------------------------------------------------------------------
# Optional Contact Integration (Optional)
# ------------------------------------------------------------------------------
# VITE_EMAILJS_SERVICE_ID=your_service_id_here
# VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
# VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
