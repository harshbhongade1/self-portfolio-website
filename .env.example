# Environment variables template (No actual secrets)
# Copy this file to .env.local for local overrides if needed

# Vite dev server port (default: 3000)
VITE_PORT=3000

# Optional: External contact service keys (if integrated in future)
# VITE_EMAILJS_SERVICE_ID=your_service_id_here
# VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
# VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
